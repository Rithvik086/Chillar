{
  "name": "chillar",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:backend",
    "build:backend": "npm run build --workspace=@chillar/backend",
    "build:packages": "npm run build --workspace=@chillar/shared && npm run build --workspace=@chillar/core && npm run build --workspace=@chillar/schemas",
    "mobile": "npm run start --workspace=@chillar/mobile",
    "android": "npm run android --workspace=@chillar/mobile",
    "backend": "npm run dev --workspace=@chillar/backend",
    "typecheck": "npm run typecheck --workspaces"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
